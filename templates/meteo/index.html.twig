<div id="weather-widget-container" style="position: absolute; top: 50px; left: 50px;">
    <div class="weather-widget" style="position: relative;">
        <span id="widget-hamburger" style="position: absolute; top: 4px; left: 4px; font-size: 13px; cursor: pointer; z-index: 1100; background: rgba(255,255,255,0.7); border-radius: 3px; padding: 1px 3px;">
            &#9776;
        </span>
        <div id="widget-menu" style="display: none; position: absolute; top: 32px; left: 4px; min-width: 120px; background: #fff; border: 1px solid #2196f3; border-radius: 4px; box-shadow: 0 2px 8px rgba(33,150,243,0.12); z-index: 1200;">
                <ul style="list-style: none; margin: 0; padding: 4px 0;">
                    <li style="padding: 2px 10px; cursor: pointer; color: #2196f3; font-size: 12px; font-family: 'Work Sans', sans-serif; font-weight: bold; letter-spacing: 0.6px;" class="widget-menu-item">Prévisions</li>
                    <li style="padding: 2px 10px; cursor: pointer; color: #2196f3; font-size: 12px; font-family: 'Work Sans', sans-serif; font-weight: bold; letter-spacing: 0.6px;" class="widget-menu-item">Historique</li>
                    <li style="padding: 2px 10px; cursor: pointer; color: #2196f3; font-size: 12px; font-family: 'Work Sans', sans-serif; font-weight: bold; letter-spacing: 0.6px;" class="widget-menu-item">Paramètres</li>
                    <li style="padding: 6px 10px; text-align:center;">
                        <button id="bug-report-btn" style="background:#e53935;color:#fff;border:none;border-radius:3px;padding:4px 12px;font-size:12px;font-weight:bold;cursor:pointer;">SOUMETTRE UN BUG</button>
                        <!-- Modale pour le bug -->
                        <div id="bug-modal" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.35); z-index:2000; justify-content:center; align-items:center;">
                            <div style="background:#fff; border-radius:10px; box-shadow:0 4px 24px rgba(33,150,243,0.18); padding:22px 20px; min-width:280px; max-width:95vw; margin:auto; position:relative; font-family:'Work Sans',sans-serif;">
                                <button id="close-bug-modal" style="position:absolute; top:10px; right:12px; background:none; border:none; font-size:22px; color:#e53935; cursor:pointer;">&times;</button>
                                <h4 style="margin:0 0 14px 0; color:#e53935; font-size:1.15em; text-align:center; font-weight:bold; letter-spacing:0.5px;">Signaler un bug</h4>
                                <div style="margin-bottom:10px; color:#333; font-size:13px; text-align:left; font-weight:500;">
                                    <span style="font-size:18px; vertical-align:middle; margin-right:6px;">📌</span> <b style="text-decoration:underline;">À lire avant de signaler un bug :</b><br>
                                </div>
                                <div style="margin-bottom:10px; color:#333; font-size:13px; text-align:left; font-weight:500;">

                                    <span style="font-size:16px; color:#2196f3; margin-right:4px;">✅</span> Décrivez clairement le problème.<br>
                                    <span style="font-size:16px; color:#2196f3; margin-right:4px;">✅</span> Ajoutez une capture d’écran si possible.<br>
                                    <span style="font-size:16px; color:#2196f3; margin-right:4px;">✅</span> Mentionnez votre navigateur / appareil.<br>
                                    <span style="font-size:16px; color:#e53935; margin-right:4px;">❌</span> Pas de langage SMS.<br>
                                    <span style="font-size:16px; color:#e53935; margin-right:4px;">❌</span> Pas de demandes de conseils ou de suggestions.<br>
                                    <span style="font-size:16px; color:#e53935; margin-right:4px;">❌</span> Pas de signalement de joueurs ici.
                                </div>
                                <form id="bug-form" style="margin:0; display:flex; flex-direction:column; gap:10px;">
                                    <input id="bug-user" type="text" maxlength="60" placeholder="Votre identifiant de jeu ou email" style="width:100%;font-size:13px;padding:7px 8px;border-radius:4px;border:1px solid #bbb; margin-bottom:2px;" required>
                                    <input id="bug-title" type="text" maxlength="80" placeholder="Résumé du bug (ex : Impossible de récolter le blé)" style="width:100%;font-size:13px;padding:7px 8px;border-radius:4px;border:1px solid #bbb; margin-bottom:2px;" required>
                                    <textarea id="bug-desc" rows="5" maxlength="600" placeholder="Description détaillée (explication, étapes pour reproduire le bug)" style="width:100%;font-size:13px;padding:7px 8px;border-radius:4px;border:1px solid #bbb; resize:vertical;" required></textarea>
                                    <select id="bug-category" style="width:100%;font-size:13px;padding:7px 8px;border-radius:4px;border:1px solid #bbb; margin-bottom:2px;" required>
                                        <option value="">Catégorie du bug</option>
                                        <option>Affichage / Interface</option>
                                        <option>Performances / Lags</option>
                                        <option>Gameplay / Fonctionnement</option>
                                        <option>Problème de compte / connexion</option>
                                        <option>Autre</option>
                                    </select>
                                    <input id="bug-device" type="text" maxlength="40" placeholder="Navigateur ou appareil utilisé (ex : Chrome, mobile...)" style="width:100%;font-size:13px;padding:7px 8px;border-radius:4px;border:1px solid #bbb; margin-bottom:2px;">
                                    <input id="bug-file" type="file" accept="image/*" style="margin-bottom:2px;">
                                    <div style="font-size:12px;color:#666;">Date et heure du bug : <span id="bug-date"></span></div>
                                    <label style="font-size:12px;color:#333; margin-top:4px;"><input type="checkbox" id="bug-copy" style="margin-right:4px;"> Recevoir une copie par email</label>
                                    <button type="submit" style="background:#e53935;color:#fff;border:none;border-radius:4px;padding:7px 0;font-size:14px;font-weight:bold;cursor:pointer;margin-top:2px;">Envoyer</button>
                                </form>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </span>
    <div class="weather-header">
        <h3 class="weather-location">{{ zone|capitalize }}</h3>
        <div class="weather-time">{{ serverTime.formattedDateTime }}</div>
    </div>
    
    {% if meteoData %}
        <div class="weather-main">
            <div class="weather-summary">
                <div class="weather-icon">
            {% set isNight = serverTime.hour < 6 or serverTime.hour >= 20 %}
            
            {% if meteoData.precipitationType %}
                <i class="fas fa-cloud-rain"></i>
            {% elseif meteoData.cloudCover > 80 %}
                <i class="fas fa-cloud"></i>
            {% elseif meteoData.cloudCover > 50 %}
                {% if isNight %}
                    <i class="fas fa-cloud-moon"></i>
                {% else %}
                    <i class="fas fa-cloud-sun"></i>
                {% endif %}
            {% else %}
                {% if isNight %}
                    <i class="fas fa-moon"></i>
                {% else %}
                    <i class="fas fa-sun"></i>
                {% endif %}
            {% endif %}
        </div>
                <div class="weather-temp">{{ meteoData.temperature }}°C</div>
                {% if isNight %}
                    <div class="weather-night">Nuit</div>
                {% else %}
                    <div class="weather-desc">{{ meteoData.summary }}</div>
                {% endif %}
                
            
            
            <ul class="weather-details">
                <li>
                    <span class="weather-label">Ressenti</span>
                    <span class="weather-value">{{ meteoData.feelsLike }}°C</span>
                </li>
                <li>
                    <span class="weather-label">Humidité</span>
                    <span class="weather-value">{{ meteoData.humidity }}%</span>
                </li>
                <li>
                    <span class="weather-label">Vent</span>
                    <span class="weather-value">{{ meteoData.windSpeed }} km/h</span>
                </li>
                <li>
                    <span class="weather-label">Pression</span>
                    <span class="weather-value">{{ meteoData.pressure }} hPa</span>
                </li>
                <li>
                    <span class="weather-label">Nuages</span>
                    <span class="weather-value">{{ meteoData.cloudCover }}%</span>
                </li>
                {% if meteoData.precipitationType %}
                <li>
                    <span class="weather-label">Précipitation</span>
                    <span class="weather-value">
                        {% set precipitationFr = '' %}
                        {% if meteoData.precipitationType == 'none' %}
                            {% set precipitationFr = 'non' %}
                        {% elseif meteoData.precipitationType == 'rain' %}
                            {% set precipitationFr = 'pluie' %}
                        {% elseif meteoData.precipitationType == 'snow' %}
                            {% set precipitationFr = 'neige' %}
                        {% elseif meteoData.precipitationType == 'sleet' %}
                            {% set precipitationFr = 'grésil' %}
                        {% elseif meteoData.precipitationType == 'hail' %}
                            {% set precipitationFr = 'grêle' %}
                        {% elseif meteoData.precipitationType == 'drizzle' %}
                            {% set precipitationFr = 'bruine' %}
                        {% elseif meteoData.precipitationType == 'thunderstorm' %}
                            {% set precipitationFr = 'orage' %}
                        {% elseif meteoData.precipitationType == 'shower' %}
                            {% set precipitationFr = 'averse' %}
                        {% elseif meteoData.precipitationType == 'mist' %}
                        {% set precipitationFr = 'brume' %}
                        {% elseif meteoData.precipitationType == 'fog' %}
                            {% set precipitationFr = 'brouillard' %}
                        {% else %}
                            {% set precipitationFr = meteoData.precipitationType %}
                        {% endif %}
                        {{ precipitationFr }}
                    </span>
                </li>
                {% endif %}
            </ul>
        </div>
    {% else %}
        <div class="weather-error">
            Données météo non disponibles pour le moment.
        </div>
    {% endif %}
    <!-- contenu du widget météo -->
    </div>
</div>
<style>
.weather-widget {
    font-size: 0.75em;
    width: 200px;
    min-width: 140px;
    max-width: 220px;
    padding: 4px 6px;
}
/* -------- MODALE BUG -------- */
#bug-modal {
    display: none;
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.35);
    z-index: 2000;
    justify-content: center;
    align-items: center;
}
#bug-modal .bug-modal-content {
    background: #f8f9fa;
    border-radius: 22px;
    box-shadow: 0 8px 32px rgba(33,150,243,0.22);
    padding: 32px 120px 24px 120px;
    min-width: 900px;
    max-width: 100vw;
    margin: auto;
    position: relative;
    font-family: 'Work Sans', sans-serif;
    animation: modalIn 0.25s;
    max-height: 38vh;
    overflow-y: auto;
}
@keyframes modalIn {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}
#bug-modal h4 {
    margin: 0 0 14px 0;
    color: #e53935;
    font-size: 1.15em;
    text-align: center;
    font-weight: bold;
    letter-spacing: 0.5px;
}
#close-bug-modal {
    position: absolute;
    top: 10px; right: 12px;
    background: none;
    border: none;
    font-size: 22px;
    color: #e53935;
    cursor: pointer;
    transition: color 0.2s;
}
#close-bug-modal:hover {
    color: #2196f3;
}
#bug-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
#bug-form input[type="text"],
#bug-form input[type="email"],
#bug-form input[type="file"],
#bug-form textarea,
#bug-form select {
    width: 100%;
    font-size: 13px;
    padding: 7px 8px;
    border-radius: 4px;
    border: 1px solid #bbb;
    margin-bottom: 2px;
    box-sizing: border-box;
    transition: border-color 0.2s;
}
#bug-form input:focus,
#bug-form textarea:focus,
#bug-form select:focus {
    border-color: #2196f3;
    outline: none;
}
#bug-form button[type="submit"] {
    background: #e53935;
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 7px 0;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
    margin-top: 2px;
    transition: background 0.2s;
}
#bug-form button[type="submit"]:hover {
    background: #2196f3;
}
#bug-form label {
    font-size: 12px;
    color: #333;
    margin-top: 4px;
}
#bug-form .bug-date {
    font-size: 12px;
    color: #666;
    margin-bottom: 2px;
}
@media (max-width: 500px) {
    #bug-modal .bug-modal-content {
        padding: 12px 4vw;
        min-width: 0;
    }
}
.weather-header h3,
.weather-header .weather-time {
    margin: 0;
    padding: 0;
    line-height: 1.1;
    font-size: 1em;
}
.weather-main {
    padding: 0;
    margin: 0;
}
.weather-summary {
    margin-bottom: 2px;
}
.weather-temp {
    font-size: 1.1em;
    margin-bottom: 2px;
}
.weather-details {
    margin: 0;
    padding: 0;
}
.weather-details li {
    padding: 0 0 2px 0;
    margin: 0;
    font-size: 0.95em;
}
#weather-widget-container {
    min-width: 180px;
    max-width: 240px;
}
.weather-widget:hover {
    cursor: move;
}
.weather-widget .hamburger-icon {
    position: absolute !important;
    top: 4px !important;
    left: 4px !important;
    font-size: 13px !important;
    cursor: pointer !important;
    z-index: 1100 !important;
    background: #f8f9fa !important;
    color: #333 !important;
    border-radius: 3px !important;
    padding: 2px 5px !important;
    box-shadow: 0 1px 4px rgba(0,0,0,0.12) !important;
    transition: background 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s !important;
    border: 1px solid #e0e0e0 !important;
}
.weather-widget .hamburger-icon:hover {
    background: #2196f3 !important;
    color: #fff !important;
    box-shadow: 0 2px 12px rgba(33,150,243,0.22) !important;
    border-color: #2196f3 !important;
    transform: rotate(20deg) scale(1.15) !important;
}
/* Ajout pour rendre l'icône hamburger bleue au survol */
#widget-hamburger:hover {
    background: #2196f3 !important;
    color: #fff !important;
    border-color: #2196f3 !important;
    box-shadow: 0 2px 12px rgba(33,150,243,0.22) !important;
    transform: scale(1.7) !important;
}
</style>
<script>
// Bouton soumettre un bug
const bugBtn = document.getElementById('bug-report-btn');
const bugModal = document.getElementById('bug-modal');
const closeBugModal = document.getElementById('close-bug-modal');
const bugForm = document.getElementById('bug-form');
const bugUser = document.getElementById('bug-user');
const bugTitle = document.getElementById('bug-title');
const bugDesc = document.getElementById('bug-desc');
const bugCategory = document.getElementById('bug-category');
const bugDevice = document.getElementById('bug-device');
const bugFile = document.getElementById('bug-file');
const bugCopy = document.getElementById('bug-copy');
const bugDate = document.getElementById('bug-date');
bugBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    bugModal.style.display = 'flex';
    bugDate.textContent = new Date().toLocaleString();
});
closeBugModal.addEventListener('click', function() {
    bugModal.style.display = 'none';
});
bugModal.addEventListener('click', function(e) {
    if (e.target === bugModal) bugModal.style.display = 'none';
});
bugForm.addEventListener('submit', function(e) {
    e.preventDefault();
    // Validation simple
    if(!bugUser.value.trim() || !bugTitle.value.trim() || !bugDesc.value.trim() || !bugCategory.value) {
        alert('Merci de remplir tous les champs obligatoires.');
        return;
    }
    // Préparation des données
    const formData = new FormData();
    formData.append('user', bugUser.value);
    formData.append('title', bugTitle.value);
    formData.append('description', bugDesc.value);
    formData.append('category', bugCategory.value);
    formData.append('device', bugDevice.value);
    formData.append('date', bugDate.textContent);
    formData.append('copy', bugCopy.checked ? '1' : '0');
    if(bugFile.files[0]) formData.append('file', bugFile.files[0]);
    fetch('/bug-report', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if(data.success) {
            alert('Merci, votre bug a été signalé et sera examiné.');
            bugForm.reset();
            bugModal.style.display = 'none';
        } else {
            alert('Erreur lors de l\'envoi.');
        }
    })
    .catch(() => {
        alert('Erreur lors de l\'envoi.');
    });
});
const container = document.getElementById('weather-widget-container');
let offsetX, offsetY, isDragging = false;

// Restaurer la position sauvegardée
const savedPos = localStorage.getItem('weatherWidgetPos');
if (savedPos) {
    const pos = JSON.parse(savedPos);
    container.style.left = pos.left;
    container.style.top = pos.top;
}

container.addEventListener('mousedown', function(e) {
    isDragging = true;
    offsetX = e.clientX - container.offsetLeft;
    offsetY = e.clientY - container.offsetTop;
    container.style.zIndex = 1000;
    document.body.style.userSelect = 'none';
});

document.addEventListener('mousemove', function(e) {
    if (isDragging) {
        const left = (e.clientX - offsetX) + 'px';
        const top = (e.clientY - offsetY) + 'px';
        container.style.left = left;
        container.style.top = top;
        // Sauvegarder la position à chaque déplacement
        localStorage.setItem('weatherWidgetPos', JSON.stringify({left, top}));
    }
});

document.addEventListener('mouseup', function() {
    isDragging = false;
    document.body.style.userSelect = '';
});

// Gestion du menu hamburger
const hamburger = document.getElementById('widget-hamburger');
const menu = document.getElementById('widget-menu');

hamburger.addEventListener('click', function(e) {
    e.stopPropagation();
    menu.style.display = (menu.style.display === 'none' || menu.style.display === '') ? 'block' : 'none';
});

// Fermer le menu si on clique ailleurs
document.addEventListener('click', function(e) {
    if (menu.style.display === 'block' && e.target !== hamburger && !menu.contains(e.target)) {
        menu.style.display = 'none';
    }
});
</script>
  <script>
    // Modal ouverture
    document.addEventListener('DOMContentLoaded', function() {
      var btn = document.getElementById('openDashboardModal');
      if(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          document.getElementById('dashboardModal').style.display = 'flex';
        });
      }

      // Effet pression sur boutons tactiles
      document.querySelectorAll('.btn').forEach(function(b){
        b.addEventListener('mousedown',function(){b.style.transform='scale(0.96)';});
        b.addEventListener('mouseup',function(){b.style.transform='scale(1)';});
        b.addEventListener('mouseleave',function(){b.style.transform='scale(1)';});
      });

      // Graphique dynamique interactif
      const graphData = {
        rendement: {
          points: '20,90 60,70 100,50 140,60 180,30 220,50 260,20 300,40',
          color: '#ffe082',
          label: 'Rendement — tendance mensuelle'
        },
        cheptel: {
          points: '20,60 60,65 100,70 140,80 180,75 220,80 260,85 300,90',
          color: '#81c784',
          label: 'Cheptel — évolution mensuelle'
        },
        finances: {
          points: '20,100 60,90 100,80 140,70 180,60 220,50 260,40 300,30',
          color: '#ef5350',
          label: 'Finances — solde mensuel'
        }
      };
      function updateGraph(type) {
        const polyline = document.getElementById('graph-polyline');
        const label = document.getElementById('graph-label');
        polyline.setAttribute('points', graphData[type].points);
        polyline.setAttribute('stroke', graphData[type].color);
        label.textContent = graphData[type].label;
      }
      document.querySelectorAll('.graph-option').forEach(function(btn){
        btn.addEventListener('click',function(){
          updateGraph(btn.getAttribute('data-type'));
        });
      });
      document.getElementById('graph-svg').addEventListener('click',function(){
        alert('Graphique interactif : cliquez sur une option pour changer la courbe.');
      });

      // Jauge carburant dynamique (exemple animée)
      let fuelLevel = 65;
      setInterval(function(){
        fuelLevel = Math.max(10, Math.min(100, fuelLevel + (Math.random()*8-4)));
        const circle = document.querySelector('#fuelGauge circle[stroke="#42a5f5"]');
        const text = document.getElementById('fuelText');
        const dashoffset = 176 - (fuelLevel/100)*176;
        circle.setAttribute('stroke-dashoffset', dashoffset);
        text.textContent = Math.round(fuelLevel) + '%';
      }, 1800);
    });
  </script>


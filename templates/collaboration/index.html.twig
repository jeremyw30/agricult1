{% extends 'base.html.twig' %}

{% block title %}Mes Collaborations{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="text-center mb-4">Mes Collaborations</h1>
    
    <!-- Invite new collaborator -->
    <div class="row mb-5">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4>Inviter un collaborateur</h4>
                </div>
                <div class="card-body">
                    <div id="invite-form">
                        <div class="form-group mb-3">
                            <label for="collaborator-email">Email du collaborateur</label>
                            <input type="email" class="form-control" id="collaborator-email" placeholder="email@example.com">
                        </div>
                        <button type="button" class="btn btn-success" onclick="inviteCollaborator()">
                            Envoyer l'invitation
                        </button>
                    </div>
                    <div id="invite-message" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending invitations -->
    {% if pendingInvitations|length > 0 %}
    <div class="row mb-4">
        <div class="col-12">
            <h3>Invitations reçues</h3>
            <div class="card">
                <div class="card-body">
                    {% for invitation in pendingInvitations %}
                    <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                        <div>
                            <strong>{{ invitation.owner.surname }}</strong> vous invite à collaborer
                            <br><small class="text-muted">{{ invitation.createdAt|date('d/m/Y à H:i') }}</small>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-success me-2" onclick="respondToInvitation({{ invitation.id }}, 'accept')">
                                Accepter
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="respondToInvitation({{ invitation.id }}, 'decline')">
                                Refuser
                            </button>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- My collaborators -->
    <div class="row mb-4">
        <div class="col-12">
            <h3>Mes collaborateurs</h3>
            <div class="card">
                <div class="card-body">
                    {% if ownedCollaborations|length > 0 %}
                        {% for collaboration in ownedCollaborations %}
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <div>
                                <strong>{{ collaboration.collaborator.surname }}</strong>
                                <span class="badge badge-{{ collaboration.status == 'accepted' ? 'success' : (collaboration.status == 'pending' ? 'warning' : 'danger') }}">
                                    {{ collaboration.status == 'accepted' ? 'Accepté' : (collaboration.status == 'pending' ? 'En attente' : 'Refusé') }}
                                </span>
                                {% if collaboration.role == 'ROLE_COLLABORATOR_WRITE' %}
                                    <span class="badge badge-info">Écriture</span>
                                {% endif %}
                                <br><small class="text-muted">Invité le {{ collaboration.createdAt|date('d/m/Y à H:i') }}</small>
                            </div>
                            <div>
                                <button class="btn btn-sm btn-danger" onclick="removeCollaboration({{ collaboration.id }})">
                                    Supprimer
                                </button>
                            </div>
                        </div>
                        {% endfor %}
                    {% else %}
                        <p class="text-muted">Aucun collaborateur pour le moment.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Collaborations I'm part of -->
    <div class="row">
        <div class="col-12">
            <h3>Projets où je collabore</h3>
            <div class="card">
                <div class="card-body">
                    {% if myCollaborations|length > 0 %}
                        {% for collaboration in myCollaborations %}
                        {% if collaboration.status == 'accepted' %}
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <div>
                                <strong>Projet de {{ collaboration.owner.surname }}</strong>
                                {% if collaboration.role == 'ROLE_COLLABORATOR_WRITE' %}
                                    <span class="badge badge-success">Accès en écriture</span>
                                {% endif %}
                                <br><small class="text-muted">Accepté le {{ collaboration.acceptedAt|date('d/m/Y à H:i') }}</small>
                            </div>
                            <div>
                                <a href="{{ path('app_ferme') }}" class="btn btn-sm btn-primary">
                                    Accéder au projet
                                </a>
                                <button class="btn btn-sm btn-secondary" onclick="removeCollaboration({{ collaboration.id }})">
                                    Quitter
                                </button>
                            </div>
                        </div>
                        {% endif %}
                        {% endfor %}
                    {% else %}
                        <p class="text-muted">Vous ne participez à aucun projet en tant que collaborateur.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
async function inviteCollaborator() {
    const email = document.getElementById('collaborator-email').value;
    const messageDiv = document.getElementById('invite-message');
    
    if (!email) {
        messageDiv.innerHTML = '<div class="alert alert-danger">Veuillez saisir un email</div>';
        return;
    }
    
    try {
        const response = await fetch('{{ path('app_collaboration_invite') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'email=' + encodeURIComponent(email)
        });
        
        const data = await response.json();
        
        if (response.ok) {
            messageDiv.innerHTML = '<div class="alert alert-success">' + data.message + '</div>';
            document.getElementById('collaborator-email').value = '';
            setTimeout(() => location.reload(), 2000);
        } else {
            messageDiv.innerHTML = '<div class="alert alert-danger">' + data.error + '</div>';
        }
    } catch (error) {
        messageDiv.innerHTML = '<div class="alert alert-danger">Erreur lors de l\'envoi de l\'invitation</div>';
    }
}

async function respondToInvitation(id, action) {
    const url = action === 'accept' 
        ? '{{ path('app_collaboration_accept', {'id': '__ID__'}) }}'.replace('__ID__', id)
        : '{{ path('app_collaboration_decline', {'id': '__ID__'}) }}'.replace('__ID__', id);
    
    try {
        const response = await fetch(url, {
            method: 'POST'
        });
        
        const data = await response.json();
        
        if (response.ok) {
            location.reload();
        } else {
            alert(data.error);
        }
    } catch (error) {
        alert('Erreur lors de la réponse à l\'invitation');
    }
}

async function removeCollaboration(id) {
    if (!confirm('Êtes-vous sûr de vouloir supprimer cette collaboration ?')) {
        return;
    }
    
    try {
        const response = await fetch('{{ path('app_collaboration_remove', {'id': '__ID__'}) }}'.replace('__ID__', id), {
            method: 'DELETE'
        });
        
        const data = await response.json();
        
        if (response.ok) {
            location.reload();
        } else {
            alert(data.error);
        }
    } catch (error) {
        alert('Erreur lors de la suppression');
    }
}
</script>
{% endblock %}
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.4);
    }
    .custom-modal-content {
        background-color: #fff;
        margin: 8% auto;
        padding: 32px 24px 24px 24px;
        border: 2px solid #8b6b47;
        width: 90%;
        max-width: 420px;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(80,80,80,0.18);
        position: relative;
        color: #333;
    }
    .custom-modal-close {
        color: #8b6b47;
        position: absolute;
        top: 12px;
        right: 18px;
        font-size: 32px;
        font-weight: bold;
        cursor: pointer;
        transition: color 0.2s;
    }
    .custom-modal-close:hover {
        color: #333;
    }
</style>

<script>
    document.querySelectorAll('.modal-link').forEach(function(link) {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            var modalId = link.getAttribute('data-modal');
            var modal = document.getElementById(modalId);
            if (modal) {
                modal.style.display = 'block';
            }
        });
    });
    document.querySelectorAll('.custom-modal-close').forEach(function(closeBtn) {
        closeBtn.addEventListener('click', function() {
            closeBtn.closest('.custom-modal').style.display = 'none';
        });
    });
    window.addEventListener('click', function(event) {
        document.querySelectorAll('.custom-modal').forEach(function(modal) {
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        });
    });
</script>

